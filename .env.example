# Copia este archivo a .env solo si quieres cambiar valores.
# Sin .env, todo arranca con proveedores simulados.

# --- Infraestructura local (no son secretos de producción) ---
POSTGRES_USER=norte
POSTGRES_PASSWORD=norte_dev
POSTGRES_DB=norte_legal

# --- Proveedores ---
# fake | openrouter, para el LLM y para los embeddings. OpenRouter sin su clave impide arrancar.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
# OPENROUTER_API_KEY=
# Modelos de pago (por defecto). Privacidad: zdr = solo proveedores con retención cero.
# LLM_MODEL=anthropic/claude-opus-5.5
# LLM_REASONING_EFFORT=medium
# EMBEDDING_MODEL=baai/bge-m3
# OPENROUTER_DATA_POLICY=zdr
# Pruebas sin coste: LLM gratuito. Los embeddings gratuitos de OpenRouter fallan con lotes de más de
# ~500 tokens, así que se mantiene bge-m3 (de pago, menos de un céntimo por la muestra de eval/).
# Este modelo gratuito admite `deny`; otros `:free` exigen `allow` (entrenan con lo que reciben).
# LLM_MODEL=dots-studio/dots-3-note-preview:free
# OPENROUTER_DATA_POLICY=deny
# Cambiar el modelo de embeddings cambia la huella del pipeline: hay que volver a subir los documentos.

# Similitud mínima para que un fragmento recuperado solo por vector llegue al LLM. Se calibra en M5.
RETRIEVAL_MIN_SIMILARITY=0.25

# Inyección de fallos del proveedor simulado: none | timeout | rate_limit | unavailable
FAKE_LLM_FAILURE_MODE=none

# --- Observabilidad ---
LOG_LEVEL=INFO
OTEL_ENABLED=true

# --- Worker ---
WORKER_CONCURRENCY=2
